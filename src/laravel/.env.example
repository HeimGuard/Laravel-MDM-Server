APP_NAME=HeimGuard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_SYSTEM_ADMINS=1
# Time zone of the script schedules (cron expressions)
# APP_TIMEZONE=Europe/Prague

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# mysql, pgsql or sqlite. Changing sqlite to pgsql copies the SQLite data into PostgreSQL once (docs/server.md).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# WebSocket server for instant command delivery to agents (php artisan reverb:start)
REVERB_APP_ID=mdm
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public address of Reverb; in Docker it is served on the web port under /app
REVERB_HOST=localhost
REVERB_PORT=8000
REVERB_SCHEME=http
# Address the Reverb server itself listens on
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Agent download for the install commands, defaults to this server (/agent/app.ps1)
# AGENT_DOWNLOAD_URL=

VITE_APP_NAME="${APP_NAME}"
